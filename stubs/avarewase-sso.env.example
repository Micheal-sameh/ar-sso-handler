# Avarewase SSO client — copy these into your app's .env and fill in the
# values from the client you registered at https://auth.avarewase.com/admin/clients

AVAREWASE_SSO_BASE_URL=https://auth.avarewase.com
AVAREWASE_SSO_CLIENT_ID=
AVAREWASE_SSO_CLIENT_SECRET=
AVAREWASE_SSO_REDIRECT_URI="${APP_URL}/login/avarewase/callback"
AVAREWASE_SSO_SCOPES="openid profile email"

AVAREWASE_SSO_GUARD=web
AVAREWASE_SSO_USER_MODEL="App\Models\User"

AVAREWASE_SSO_ROUTES_ENABLED=true

AVAREWASE_SSO_HTTP_TIMEOUT=5
AVAREWASE_SSO_HTTP_CONNECT_TIMEOUT=3
AVAREWASE_SSO_HTTP_RETRY_TIMES=2
AVAREWASE_SSO_HTTP_RETRY_SLEEP_MS=200
